APP_NAME=Gatekeeper
DATABASE_URL=sqlite:///./gatekeeper.db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
ETHERSCAN_API_KEY=your_etherscan_api_key
UPLOAD_DIR=uploads

# OSINT SCRAPER CREDENTIALS
X_USERNAME=your_x_username
X_AUTH_TOKEN=your_x_auth_token
X_TARGET_USERNAME=binance
X_SCAN_LIMIT=20

TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_CHANNELS=your_channel_ids
TELEGRAM_PUBLIC_OSINT_ENABLED=true
TELEGRAM_PUBLIC_CHANNELS=binance,binance_announcements,bitcoin,ethereum
TELEGRAM_PUBLIC_OSINT_LIMIT=50
TELEGRAM_PUBLIC_OSINT_INTERVAL=300
